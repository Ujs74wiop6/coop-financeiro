# Copie para ".env":  cp .env.example .env

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque_esta_senha
# localhost = rodando o back-end fora do Docker. No Docker o compose troca para "db".
DB_HOST=localhost
DB_PORT=5432

# --- Segurança (JWT) ---
# Chave que assina os tokens. Em produção use algo longo e aleatório.
JWT_SECRET=troque-esta-chave-por-uma-bem-longa-e-aleatoria-123456
JWT_EXPIRA_MINUTOS=60

# Usuário criado automaticamente no primeiro start (para conseguir logar)
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
