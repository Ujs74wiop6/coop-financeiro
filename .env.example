# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque_esta_senha

# --- Back-end ---
# Chave que assina os tokens JWT. Em produção use algo longo e aleatório.
JWT_SECRET=troque_esta_chave_secreta
JWT_EXPIRA_MINUTOS=60

# Usuário criado automaticamente no primeiro start (para conseguir logar)
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
