# Copie para "frontend.env":  cp frontend.env.example frontend.env

# Onde está a API do back-end.
# localhost = rodando fora do Docker. No Docker o compose troca para http://backend:5000/api
BACKEND_URL=http://localhost:5000/api

# Chave que assina o cookie de sessão (onde ficam o JWT e o nome do usuário).
SECRET_KEY=troque-esta-chave-por-uma-bem-longa-e-aleatoria-654321
